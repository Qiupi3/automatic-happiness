{
  "manifest_version": 2,
  "version": "1.0",
  "name": "Frieren (Dark Mode Animated)",
  "theme": {
    "images": {
      "theme_frame": "images/0.png",
      "additional_backgrounds": [
        "images/1.png",
        "images/2.png"
      ]
    },
    "colors": {
      "frame": "#1e1e24",
      "tab_background_text": "#ffffff"
    },
    "properties": {
      "additional_backgrounds_alignment": [
        "center top",
        "right top"
      ],
      "additional_backgrounds_tiling": [
